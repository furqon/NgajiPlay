# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
# Generated from the pinned sources on every build
public/quran.json

# Python virtualenv and bytecode for the one-off font subsetting
.venv/
__pycache__/
*.pyc

# Test artifacts
test-results/
playwright-report/
blob-report/

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local env and host config
.env
.env.*
!.env.example
.vercel/
*.local

# Local toolchains for the Android build (JDK, SDK) — never committed
.tools/

# Logs
*.log
npm-debug.log*

# Android build output and the synced copy of dist (regenerate with `npx cap sync android`)
android/app/build/
android/.gradle/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/keystore.properties

# Built APKs are artifacts, not source
release/
