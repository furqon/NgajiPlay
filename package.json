{
  "name": "ngajiplay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Record a child's Quran recitation per surah slice and replay it on the Madani page.",
  "scripts": {
    "predev": "node scripts/build-quran-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-quran-data.mjs",
    "build": "vite build && node scripts/check-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "lint": "eslint .",
    "icons": "node scripts/gen-icons.mjs",
    "pretest:e2e": "npm run build",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e",
    "icons:android": "node scripts/gen-android-icons.mjs"
  },
  "dependencies": {
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
